    def __init__(self, pre_shared_key: bytes, gatekeep
er_pass: str):
        self._psk = pre_shared_key
        self._gatekeeper_pass = gatekeeper_pass
        self.format_registry = json.loads(json.dumps(F
ILE_FORMAT_PLACEHOLDERS))

    @staticmethod
    def canonical_serialize(payload: Dict[str, Any]) -
> bytes:
        return json.dumps(
            payload, sort_keys=True, separators=(",",
":"), ensure_ascii=True
        ).encode("utf-8")

    @staticmethod
    def compute_file_sha256(file_path: str) -> str:
        h = hashlib.sha256()
        with open(file_path, "rb") as f:
            for chunk in iter(lambda: f.read(65536), b
""):
                h.update(chunk)
        return h.hexdigest()

    def set_format_placeholder(
        self,
        family: str,
        ext: str,
        sha256_digest: Optional[str] = None,
        source_path: Optional[str] = None,
        status_label: str = "PLACEHOLDER_READY",
    ) -> None:
        if family not in self.format_registry:
            raise KeyError(f"Unknown format family: {f
amily}")
        if ext not in self.format_registry[family]["sl
ots"]:
            raise KeyError(f"Extension {ext} not regis
tered in {family}")
        self.format_registry[family]["slots"][ext] = {

            "status": "BOUND" if sha256_digest else st
atus_label,
            "sha256": sha256_digest,
            "path": source_path,
        }

    def bind_local_file(self, family: str, ext: str, f
ile_path: str) -> str:
        if not os.path.isfile(file_path):
            raise FileNotFoundError(f"Target file not
found: {file_path}")
        digest = self.compute_file_sha256(file_path)
        self.set_format_placeholder(family, ext, sha25
6_digest=digest, source_path=file_path)
        return digest

    def registry_summary(self) -> Dict[str, Any]:
        total_slots = 0
        bound_slots = 0
        ready_slots = 0
        for fam in self.format_registry.values():
            for slot in fam["slots"].values():
                total_slots += 1
                if slot["status"] == "BOUND":
                    bound_slots += 1
                else:
                    ready_slots += 1
        return {
            "families": len(self.format_registry),
            "total_slots": total_slots,
            "bound_slots": bound_slots,
            "placeholder_ready_slots": ready_slots,
        }

