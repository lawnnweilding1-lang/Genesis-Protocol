),
    ("FINALIZED", "QUARANTINED"),
    ("QUARANTINED", "RECOVERY_REQUIRED"),
}


def canonical_bytes(obj: Any) -> bytes:
    return json.dumps(
        obj, sort_keys=True, separators=(",", ":"), en
sure_ascii=True
    ).encode("utf-8")


def sha256_of(obj: Any) -> str:
    return hashlib.sha256(canonical_bytes(obj)).hexdig
est()


def reconcile_abc(
    input_a: Dict[str, Any],
    input_b_items: List[Dict[str, Any]],
) -> Dict[str, Any]:
    base_facts = {k: v for k, v in input_a.items() if
k != "claims"}
    a_claims: List[Any] = list(input_a.get("claims") o
r [])
    resolved_facts: Dict[str, Any] = dict(base_facts)
    unresolved: List[Dict[str, Any]] = []

    a_seen: Dict[str, Tuple[int, Any]] = {}
    for i, claim in enumerate(a_claims):
        d = sha256_of(claim)
        if not isinstance(claim, dict) or "key" not in
 claim or "value" not in claim:
            unresolved.append({
                "source": "A",
                "source_index": i,
                "reason": "CORRUPTED_OR_MISSING_FIELDS
",
                "digest": d,
                "raw_preserved": claim,
            })
            continue

        k, v = claim["key"], claim["value"]
        conflict = None
        if k in a_seen and a_seen[k][1] != v:
            conflict = ("CONTRADICTS_PRIOR_A_CLAIM", a
_seen[k][0], a_seen[k][1])
        elif k in base_facts and base_facts[k] != v:
            conflict = ("CONTRADICTS_A_BASE_FACT", Non
e, base_facts[k])

        if conflict:
            kind, prior_idx, prior_val = conflict
            unresolved.append({
                "source": "A",
                "source_index": i,
                "reason": "INTERNAL_CONTRADICTION_IN_A
",
                "key": k,
                "conflict_kind": kind,
                "prior_index": prior_idx,
                "prior_value": prior_val,
                "conflicting_value_in_a": v,
                "digest": d,
                "raw_preserved": claim,
            })
        else:
            a_seen[k] = (i, v)
            resolved_facts.setdefault(k, v)

    seen_digests = set()
    for idx, item in enumerate(input_b_items):
        item_digest = sha256_of(item)
        if item_digest in seen_digests:
            unresolved.append({
                "source": "B",
                "source_index": idx,
                "reason": "DUPLICATE_INPUT",
                "digest": item_digest,
                "raw_preserved": item,
            })
            continue
        seen_digests.add(item_digest)

        if (
            not isinstance(item, dict)
            or item.get("corrupted") is True
            or "key" not in item
            or "value" not in item
        ):
            unresolved.append({
                "source": "B",
                "source_index": idx,
                "reason": "CORRUPTED_OR_MISSING_FIELDS
",
                "digest": item_digest,
                "raw_preserved": item,
            })
            continue

        k, v = item["key"], item["value"]
        if k in resolved_facts and resolved_facts[k] !
= v:
            unresolved.append({
                "source": "B",
                "source_index": idx,
                "reason": "CONTRADICTION_WITH_A",
                "key": k,
                "value_in_a": resolved_facts[k],
                "conflicting_value_in_b": v,
                "digest": item_digest,
                "raw_preserved": item,
            })
        else:
            resolved_facts[k] = v

    status = (
        "PARTIAL_WITH_OPEN_UNRESOLVED" if unresolved e
