def verify_unresolved_preservation(
    input_a: Dict[str, Any],
    input_b_items: List[Dict[str, Any]],
    unresolved: List[Dict[str, Any]],
) -> List[str]:
    errors: List[str] = []
    a_claims = list(input_a.get("claims") or [])
    for r in unresolved:
        src = r.get("source")
        idx = r.get("source_index")
        container = a_claims if src == "A" else input_
b_items if src == "B" else None
        if container is None:
            errors.append(f"unknown source {src!r} in
{r.get('reason')}")
            continue
        if not isinstance(idx, int) or not (0 <= idx <
 len(container)):
            errors.append(f"bad source_index {idx!r} f
or {r.get('reason')}")
            continue
        if container[idx] != r.get("raw_preserved"):
            errors.append(f"raw_preserved != source[{s
rc}][{idx}] for {r.get('reason')}")
        if sha256_of(r.get("raw_preserved")) != r.get(
"digest"):
            errors.append(f"digest != sha256(raw_prese
rved) for {r.get('reason')}")
    return errors


