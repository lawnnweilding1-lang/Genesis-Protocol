#!/usr/bin/env python3
import json
import os
import subprocess
import sys
import urllib.request

# Change this IP to your computer's local IP on Wi-Fi (e.g. "192.168.1.50")
LM_STUDIO_HOST = "192.168.1.50"  
LM_STUDIO_PORT = 1234
API_URL = f"http://{LM_STUDIO_HOST}:{LM_STUDIO_PORT}/v1/chat/completions"
MODEL_NAME = "qwen/qwen3.5-9b"

SYSTEM_PROMPT = """You are Qwen, the Lead Autonomous Systems Architect and Orchestrator for Genesis Enterprise / Apex Architectures.

Your Responsibilities:
1. Orchestrate local bash commands, Python scripts, and terminal pipelines deterministically.
2. Maintain high-level architectural precision for local execution nodes and enterprise workflows.
3. Keep answers concise, direct, and actionable without conversational filler.

When generating commands or code to be run locally, ensure syntax is strictly executable for the target environment (Linux/Termux)."""

def call_qwen(prompt: str) -> str:
    payload = {
        "model": MODEL_NAME,
        "messages": [
            {"role": "system", "content": SYSTEM_PROMPT},
            {"role": "user", "content": prompt}
        ],
        "temperature": 0.2,
        "stream": False
    }

    headers = {"Content-Type": "application/json"}
    data = json.dumps(payload).encode("utf-8")
    req = urllib.request.Request(API_URL, data=data, headers=headers)

    try:
        with urllib.request.urlopen(req, timeout=60) as response:
            res_data = json.loads(response.read().decode("utf-8"))
            return res_data["choices"][0]["message"]["content"]
    except Exception as e:
        return f"[ERROR]: Failed to connect to LM Studio at {API_URL}. Details: {e}"

def main():
    print("==================================================")
    print(" APEX ARCHITECTURES :: LOCAL ORCHESTRATOR (QWEN) ")
    print("==================================================")
    print(f"Target Server: {API_URL}")
    print("Type 'exit' or 'quit' to stop.\n")

    while True:
        try:
            user_input = input("Orchestrator Task > ").strip()
            if not user_input:
                continue
            if user_input.lower() in ["exit", "quit"]:
                print("Shutting down session.")
                break

            response = call_qwen(user_input)
            print("\n--- QWEN RESPONSE ---")
            print(response)
            print("---------------------\n")

        except KeyboardInterrupt:
            print("\nExiting.")
            sys.exit(0)

if __name__ == "__main__":
    main()
